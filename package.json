{
  "name": "sdd-viewer",
  "version": "0.2.0",
  "description": "Viewer desktop (Electron) para os artefatos do SDD lp:* — projetos, mudanças e artefatos .md/.html com fast refresh.",
  "main": "./out/main/index.js",
  "author": "Luan Poppe",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "start": "electron-vite preview",
    "dist": "npm run build && electron-builder --win --publish=never",
    "dist:publish": "npm run build && electron-builder --win --publish=always"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "js-yaml": "^4.1.0",
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.9.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "build": {
    "appId": "com.luanpoppe.sddviewer",
    "productName": "sdd-viewer",
    "directories": {
      "output": "dist"
    },
    "files": ["out/**/*"],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    },
    "publish": {
      "provider": "github",
      "owner": "luanpoppe",
      "repo": "sdd-viewer"
    }
  }
}
